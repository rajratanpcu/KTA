# .env.example

# Database Configuration (Phase 2+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kta_erp
DB_USER=kta
DB_PASSWORD=your_secure_password_here

# Backend Configuration (Phase 2+)
BACKEND_PORT=8080
JWT_SECRET=your_jwt_secret_here

# n8n Configuration (Phase 5+)
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# IMPORTANT: Never commit actual passwords or secrets to git
# Copy this file to .env and fill in real values for local development
