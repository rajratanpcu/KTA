# ==========================================
# KTA ERP - Environment Variables Template
# ==========================================

# Database Configuration (PostgreSQL 15 / Neon / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kta_erp
SPRING_DATASOURCE_USERNAME=kta
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
DB_PASSWORD=your_secure_db_password
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=2

# Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated list of frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Document Upload Storage (Local Path or Persistent Mount)
UPLOAD_DIR=/tmp/kta-uploads

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=https://your-backend.onrender.com
